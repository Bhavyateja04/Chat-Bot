# ---------------------------------------------------------------------------
# ResumeMatch AI - copy this file to `.env` and fill in your values.
# `.env` is git-ignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Discord (required) ----------------------------------------------------
# Discord Developer Portal -> Your App -> Bot -> Reset Token -> Copy
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# --- LLM (required unless DEMO_MODE=true) ----------------------------------
# The client is provider agnostic. Set LLM_PROVIDER to the wire format:
#   anthropic -> POST {LLM_BASE_URL}/messages
#   openai    -> POST {LLM_BASE_URL}/chat/completions  (also Groq, Together,
#                Together, OpenRouter, Ollama, LM Studio, any compatible gateway)
LLM_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-5
LLM_PROVIDER=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1

# Example - OpenAI instead:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Example - a local Ollama server (no API cost):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# --- Behaviour -------------------------------------------------------------
# DEMO_MODE=true skips every LLM call and uses the deterministic analysis
# engine. Useful for offline demos, CI and keeping API costs at zero.
DEMO_MODE=false

MAX_FILES_PER_SESSION=10
MAX_FILE_SIZE_MB=10
MAX_DOCUMENT_CHARS=20000
SESSION_TTL_MINUTES=60
LOG_LEVEL=INFO
